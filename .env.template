# FastGPT Pro API 环境变量配置模板
# 复制此文件为 .env.local 并修改相应的值

# ============ 数据库连接 ============
# MongoDB 连接字符串（必须）
# 格式: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI="mongodb://myusername:mypassword@localhost:27017/fastgpt?authSource=admin"

# Redis 连接字符串（必须）
# 格式: redis://[:password]@host:port[/db-number]
REDIS_URL="redis://default:mypassword@127.0.0.1:6379"

# ============ 认证配置 ============
# JWT Token 密钥（必须，用于生成和验证 token）
# 建议使用随机生成的长字符串，例如: openssl rand -base64 32
TOKEN_KEY="your-secret-key-change-this-in-production"

# ============ 服务配置 ============
# FastGPT Pro 服务地址（必须，用于 API 回调和 Webhook）
# 生产环境应使用实际的域名，如: https://pro.fastgpt.com
PRO_URL="http://localhost:3000"

# 主 FastGPT 服务地址（如果需要与主服务通信）
FASTGPT_BASE_URL="http://localhost:3001"

# ============ Session 配置 ============
# 最大登录会话数（可选，默认 10）
MAX_LOGIN_SESSION=10

# Session 过期时间（秒，可选，默认 7 天）
SESSION_EXPIRE_SECONDS=604800

# ============ 跨域配置 ============
# 允许的来源域名（多个用逗号分隔）
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3002"

# ============ 支付配置（如果启用支付功能）============
# 微信支付
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_KEY=""
WECHAT_PAY_CERT_PATH=""

# 支付宝支付
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""

# ============ OAuth 登录（如果启用第三方登录）============
# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 微信扫码登录
WECHAT_LOGIN_APP_ID=""
WECHAT_LOGIN_APP_SECRET=""

# ============ 其他可选配置 ============
# 开发/测试模式（设置为 true 跳过认证，仅用于开发）
TEST_MODE=false

# 日志级别
LOG_LEVEL=info

# API 端口（默认 3000）
PORT=3000

# Node 环境
NODE_ENV=production